# GEMMA_DATA_ROOT=/absolute/path/to/shared/data
# GEMMA_SAE_RUNS_DIR=/absolute/path/to/results
# HF_HOME=/absolute/path/to/huggingface/cache
# Authenticate with make login; never commit access tokens.
