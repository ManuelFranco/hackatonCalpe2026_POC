# Copy to .env. make commands load it automatically.
GEMMA_DEVICE=auto
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
FEATURE_TOKEN_SCOPE=all
FEATURE_AGGREGATION=mean
SAE_CHUNK_TOKENS=32
