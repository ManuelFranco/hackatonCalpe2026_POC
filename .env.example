# Copia este archivo a .env. Los comandos make lo cargan con uv.
# make mac fuerza mps; make server fuerza cuda; make run respeta este valor.
GEMMA_DEVICE=auto
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860

# Para reducir el tamaño de los bloques procesados por los SAEs:
SAE_CHUNK_TOKENS=32
# SAVE_RESIDUALS=0
# GEMMA_SAE_RUNS_DIR=/ruta/a/resultados
# HF_HOME=/ruta/a/cache/huggingface

# Preferible autenticar con make login. No subas tokens al repositorio.
# HF_TOKEN=
